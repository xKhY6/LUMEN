{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Jouer a LUMEN - La citadelle silencieuse",
            "type": "process",
            "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
            "args": ["run", "--release"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:LOCALAPPDATA}\\Mvania\\tools\\mingw64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Compiler LUMEN - La citadelle silencieuse",
            "type": "process",
            "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
            "args": ["build", "--release"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:LOCALAPPDATA}\\Mvania\\tools\\mingw64\\bin;${env:PATH}"
                }
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Tester LUMEN - La citadelle silencieuse",
            "type": "process",
            "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:LOCALAPPDATA}\\Mvania\\tools\\mingw64\\bin;${env:PATH}"
                }
            },
            "group": "test",
            "problemMatcher": ["$rustc"]
        }
    ]
}